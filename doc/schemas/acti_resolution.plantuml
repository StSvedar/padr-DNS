@startuml

start
:Copier "root_ips" dans "current_destinations";
:Boucle : max_iterations (défaut = 10);

while (Itérations non atteintes ET destinations non vides ?) is (oui)
  :Cible = current_destinations[0];
  :Forcer query.rd = 0;
  
  :Envoi requête UDP à Cible;
  if (Réponse reçue ET flag TC == 1 ?) then (oui)
    :Trame tronquée;
    :Fallback : Envoi requête TCP à Cible;
  else (non)
  endif
  
  if (Réponse DNS obtenue ?) then (oui)
    if (answers > 0 OU rcode != NOERROR OU aa == 1 ?) then (oui)
      :Réponse finale ou erreur légitime trouvée;
      stop
    else (non)
      :Délégation (Referral) reçue;
      :_extract_delegation(response);
      note right
        Recherche des RecordType.A
        dans la section Additional
      end note
      
      if (Nouvelles IPs trouvées ?) then (non)
        :Cul-de-sac (Aucune IP fournie);
        break
      else (oui)
        :Remplacer "current_destinations" 
        par ces nouvelles IPs;
      endif
    endif
    
  else (non)
    :Timeout ou Erreur réseau;
    :Retirer Cible de "current_destinations" (pop);
  endif
  
endwhile (non)

:Construire réponse SERVFAIL;
note right
  Généré si trop d'itérations
  ou si plus aucun serveur ne répond
end note
stop
@enduml