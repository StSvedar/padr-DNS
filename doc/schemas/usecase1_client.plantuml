@startuml
left to right direction


actor "Utilisateur" as User

package "Outil Client (CLI)" {
  
  usecase "Interroger un nom de domaine" as UC_Query
  usecase "Demander IPv4 (Type A)" as UC_A
  usecase "Demander IPv6 (Type AAAA)" as UC_AAAA
  usecase "Désactiver la récursion (RD=0)" as UC_NoRec
  usecase "Vider le cache local" as UC_Clear
  
  usecase "Envoyer la requête réseau" as UC_Send
  usecase "Recevoir et afficher la réponse" as UC_Receive

  User --> UC_Query
  User --> UC_Clear

  UC_A -up-|> UC_Query
  UC_AAAA -up-|> UC_Query
  UC_NoRec .> UC_Query : <<extend>>

  UC_Query ..> UC_Send : <<include>>
  UC_Query ..> UC_Receive : <<include>>
}
@enduml