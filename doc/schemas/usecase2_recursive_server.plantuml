@startuml
left to right direction

agent "Client CLI" as Client

package "Serveur Récursif (Résolveur)" {
  
  usecase "Traiter une requête entrante" as UC_Process
  usecase "Désérialiser la trame UDP/TCP" as UC_Parse
  usecase "Interroger le cache interne" as UC_Cache
  
  usecase "Effectuer la boucle itérative\n(Délégation)" as UC_Delegation
  usecase "Relancer la requête en TCP" as UC_TCP
  
  usecase "Mettre à jour le cache" as UC_UpdateCache
  usecase "Stocker le TTL (Positif)" as UC_CachePos
  usecase "Stocker le TTL SOA (NXDOMAIN)" as UC_CacheNeg

  Client --> UC_Process
  
  UC_Process ..> UC_Parse : <<include>>
  UC_Process ..> UC_Cache : <<include>>
  
  UC_Delegation .> UC_Process : <<extend>>\n(Si non trouvé)
  UC_TCP .> UC_Delegation : <<extend>>\n(Si trame reçue TC=1)
  
  UC_Delegation ..> UC_UpdateCache : <<include>>
  UC_CachePos -up-|> UC_UpdateCache
  UC_CacheNeg -up-|> UC_UpdateCache
}
@enduml